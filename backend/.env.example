# PostgreSQL
DB_JDBC_URL=jdbc:postgresql://localhost:5432/ride_booking
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

# HTTP / frontend origin
# Hosting providers normally set PORT automatically.
PORT=8080
CORS_ORIGINS=http://localhost:5173

# Logging
HIBERNATE_LOG_SQL=false

# Brevo SMTP
MAIL_FROM=your_verified_sender@example.com
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_START_TLS=REQUIRED
MAIL_MOCK=false
BREVO_USERNAME=your_brevo_smtp_username
BREVO_SMTP_KEY=your_brevo_smtp_key
