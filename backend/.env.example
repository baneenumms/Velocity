# PostgreSQL
DB_JDBC_URL=jdbc:postgresql://localhost:5432/ride_booking
DB_USERNAME=your_database_username
DB_PASSWORD=your_database_password

# HTTP / frontend origin
# Hosting providers normally set PORT automatically.
PORT=8080
CORS_ORIGINS=http://localhost:5173

# Logging
HIBERNATE_LOG_SQL=false

# Brevo HTTPS API
MAIL_FROM=your_verified_sender@example.com
BREVO_API_KEY=your_brevo_api_key
